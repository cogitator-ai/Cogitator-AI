FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_SITE_URL=https://cogitator.app

RUN corepack enable && corepack prepare pnpm@8.12.0 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@cogitator-ai/dashboard...

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3005

WORKDIR /app

RUN chown node:node /app

COPY --from=builder --chown=node:node /app/packages/dashboard/.next/standalone ./
COPY --from=builder --chown=node:node /app/packages/dashboard/.next/static ./packages/dashboard/.next/static
COPY --from=builder --chown=node:node /app/packages/dashboard/public ./packages/dashboard/public

USER node
WORKDIR /app/packages/dashboard

EXPOSE 3005
CMD ["node", "server.js"]
