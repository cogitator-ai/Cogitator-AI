{
  "name": "cogitator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Sovereign AI Agent Runtime - Self-hosted, production-grade orchestration for LLM swarms and autonomous agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git"
  },
  "license": "MIT",
  "author": "Your Name",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "node packages/cli/dist/index.js",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "check:esm": "tsx scripts/check-esm-imports.ts",
    "check:packages": "tsx scripts/check-packages.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "node -e \"try { if (process.env.CI !== 'true' && process.env.VERCEL !== '1') require('husky').install() } catch(e) {}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "dashboard": "pnpm --filter @cogitator-ai/dashboard dev",
    "dashboard:build": "pnpm --filter @cogitator-ai/dashboard build",
    "dashboard:start": "pnpm --filter @cogitator-ai/dashboard start",
    "services": "docker-compose up -d",
    "services:down": "docker-compose down",
    "start": "pnpm build && concurrently \"pnpm services\" \"pnpm dashboard\"",
    "gauntlet": "pnpm --filter @cogitator-ai/gauntlet start",
    "memory-bench": "pnpm --filter @cogitator-ai/gauntlet memory-bench"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "ogg-opus-decoder": "^1.7.5",
    "openai": "^7.39.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "publint": "^0.3.25",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  }
}
