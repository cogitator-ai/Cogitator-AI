{
  "name": "@cogitator-ai/koa",
  "version": "0.6.11",
  "description": "Koa server adapter for Cogitator AI runtime",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/memory": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "@cogitator-ai/server-shared": "workspace:*"
  },
  "peerDependencies": {
    "koa": ">=2.15.0",
    "@koa/router": ">=12.0.0"
  },
  "optionalDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "supertest": "^7.3.0",
    "@types/supertest": "^7.2.1",
    "vitest": "^5.0.3",
    "@types/koa": "^3.0.3",
    "@types/ws": "^8.18.2",
    "koa": "^3.2.1",
    "@koa/router": "^15.7.0",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/koa"
  },
  "license": "MIT",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "koa",
    "server",
    "api",
    "streaming",
    "sse",
    "websocket",
    "llm",
    "middleware"
  ]
}
