{
  "name": "@cogitator-ai/sandbox",
  "version": "0.8.8",
  "description": "Sandbox execution for Cogitator agents (Docker, WASM, and remote workspaces on E2B, Daytona and Vercel Sandbox)",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "sandbox",
    "code-execution",
    "isolation",
    "docker",
    "wasm",
    "e2b",
    "daytona",
    "vercel-sandbox"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "SANDBOX_BENCHMARK=1 vitest run benchmark"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@extism/extism": "^2.0.0-rc13",
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@daytona/sdk": "^0.226.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.20.4",
    "@vercel/sandbox": "^3.9.0",
    "e2b": "^2.59.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@daytona/sdk": ">=0.226.0 <1.0.0",
    "@extism/extism": "^2.0.0-rc13",
    "@vercel/sandbox": "^3.9.0",
    "dockerode": "^4.0.0 || ^5.0.0",
    "e2b": "^2.28.1"
  },
  "peerDependenciesMeta": {
    "@daytona/sdk": {
      "optional": true
    },
    "@extism/extism": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    },
    "e2b": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/sandbox"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
