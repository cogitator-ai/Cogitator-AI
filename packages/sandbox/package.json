{
  "name": "@cogitator-ai/sandbox",
  "version": "0.5.10",
  "description": "Sandbox execution for Cogitator agents (Docker and WASM)",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "sandbox",
    "code-execution",
    "isolation",
    "docker",
    "wasm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "SANDBOX_BENCHMARK=1 vitest run benchmark"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*"
  },
  "optionalDependencies": {
    "@extism/extism": "^2.0.0-rc13",
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@extism/extism": "^2.0.0-rc13",
    "dockerode": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@extism/extism": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/sandbox"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
