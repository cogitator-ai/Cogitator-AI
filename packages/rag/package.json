{
  "name": "@cogitator-ai/rag",
  "version": "0.3.4",
  "description": "Retrieval Augmented Generation for Cogitator AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@cogitator-ai/memory": "workspace:>=0.10.0"
  },
  "peerDependenciesMeta": {
    "@cogitator-ai/memory": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "cheerio": "^1.0.0",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@cogitator-ai/memory": "workspace:*",
    "@types/papaparse": "^5.3.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/rag"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
