{
  "name": "@cogitator-ai/memory",
  "version": "0.11.8",
  "description": "Memory adapters for Cogitator AI agents",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "memory",
    "embeddings",
    "vector-search",
    "redis",
    "postgres",
    "sqlite",
    "mongodb",
    "qdrant"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/redis": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@qdrant/js-client-rest": "^1.10.0",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "ioredis": "^5.0.0 || ^6.0.0",
    "mongodb": "^6.0.0 || ^7.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@qdrant/js-client-rest": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/memory"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
