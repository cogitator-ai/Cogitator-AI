{
  "name": "@cogitator-ai/cli",
  "version": "0.17.0",
  "description": "CLI for Cogitator AI Agent Runtime",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "cli",
    "agent-runtime",
    "scaffolding",
    "deploy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cogitator": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@cogitator-ai/app-server": "workspace:*",
    "@cogitator-ai/channels": "workspace:*",
    "@cogitator-ai/config": "workspace:*",
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/deploy": "workspace:*",
    "@cogitator-ai/evals": "workspace:*",
    "@cogitator-ai/mcp": "workspace:*",
    "@cogitator-ai/memory": "workspace:*",
    "@cogitator-ai/models": "workspace:*",
    "@cogitator-ai/server-shared": "workspace:*",
    "@cogitator-ai/studio": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "create-cogitator-app": "workspace:^",
    "esbuild": "^0.28.2",
    "ora": "^9.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
