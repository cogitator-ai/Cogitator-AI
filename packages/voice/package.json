{
  "name": "@cogitator-ai/voice",
  "version": "0.3.3",
  "description": "Voice/Realtime agent capabilities for Cogitator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*",
    "nanoid": "^6.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@cogitator-ai/core": "workspace:>=0.24.0",
    "openai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@cogitator-ai/core": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/voice"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
