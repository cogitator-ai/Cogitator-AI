{
  "name": "@cogitator-ai/core",
  "version": "0.30.2",
  "description": "Core runtime for Cogitator AI agents",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "ai-agents",
    "llm",
    "agent-runtime",
    "tool-calling",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@cogitator-ai/memory": "workspace:*",
    "@cogitator-ai/models": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "nanoid": "^6.0.1",
    "openai": "^7.25.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1145.0",
    "@cogitator-ai/sandbox": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@cogitator-ai/sandbox": "workspace:>=0.5.5",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "langfuse": "^3.0.0",
    "nodemailer": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@cogitator-ai/sandbox": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "langfuse": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
