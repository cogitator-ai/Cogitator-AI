{
  "name": "@cogitator-ai/acp",
  "version": "0.2.2",
  "description": "Agent Client Protocol for Cogitator: serve Cogitator agents to editors, and run external ACP agents as session providers",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "acp",
    "agent-client-protocol",
    "zed",
    "editor",
    "json-rpc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.2",
    "@cogitator-ai/app-server": "workspace:*",
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/mcp": "workspace:*",
    "@cogitator-ai/server-shared": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cogitator-ai/test-utils": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/acp"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
