{
  "name": "@cogitator-ai/evals",
  "version": "0.5.1",
  "description": "Evaluation framework for Cogitator AI agents",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "evals",
    "evaluation",
    "llm-as-judge",
    "a-b-testing",
    "testing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@cogitator-ai/core": "workspace:>=0.30.4"
  },
  "peerDependenciesMeta": {
    "@cogitator-ai/core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@types/papaparse": "^5.3.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/evals"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
