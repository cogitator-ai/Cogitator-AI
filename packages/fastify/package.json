{
  "name": "@cogitator-ai/fastify",
  "version": "0.7.1",
  "description": "Fastify server adapter for Cogitator AI runtime",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "@cogitator-ai/server-shared": "workspace:*",
    "fastify-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0"
  },
  "optionalDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.0.0 || ^6.0.0",
    "@fastify/rate-limit": "^10.0.0 || ^11.0.0",
    "@fastify/websocket": "^11.3.3"
  },
  "devDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.3",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "fastify": "^5.12.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/fastify"
  },
  "license": "MIT",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "fastify",
    "server",
    "api",
    "streaming",
    "sse",
    "websocket",
    "llm"
  ]
}
