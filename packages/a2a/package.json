{
  "name": "@cogitator-ai/a2a",
  "version": "0.6.0",
  "description": "A2A (Agent-to-Agent) Protocol v0.3 implementation for Cogitator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./koa": {
      "types": "./dist/adapters/koa.d.ts",
      "import": "./dist/adapters/koa.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@cogitator-ai/core": "workspace:>=0.25.0",
    "express": ">=4.18.0",
    "fastify": ">=4.0.0",
    "hono": ">=4.0.0",
    "koa": ">=2.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "@cogitator-ai/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/a2a"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
