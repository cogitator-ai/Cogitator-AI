{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["COGITATOR_UMAMI_WEBSITE_ID"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/examples/**/*.ts",
        "$TURBO_ROOT$/examples/package.json"
      ]
    }
  }
}
