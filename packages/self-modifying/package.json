{
  "name": "@cogitator-ai/self-modifying",
  "version": "17.0.18",
  "description": "Self-modifying agent capabilities for Cogitator - tool generation, meta-reasoning, architecture evolution",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cogitator-ai/types": "workspace:*",
    "nanoid": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.3.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "ai",
    "agent",
    "self-modifying",
    "meta-reasoning",
    "tool-generation",
    "llm"
  ],
  "author": "Cogitator Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/self-modifying"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
