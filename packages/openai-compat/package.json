{
  "name": "@cogitator-ai/openai-compat",
  "version": "21.1.13",
  "description": "OpenAI Assistants API compatibility layer for Cogitator",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "openai",
    "assistants-api",
    "compatibility"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "fastify": "^5.12.5",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.20.4",
    "openai": "^7.27.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@cogitator-ai/core": "workspace:>=0.33.0",
    "@cogitator-ai/types": "workspace:>=0.35.0",
    "ioredis": "^5.0.0 || ^6.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/openai-compat"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
