{
  "name": "@cogitator-ai/workflows",
  "version": "0.11.10",
  "description": "DAG-based workflow engine for Cogitator agents",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "workflows",
    "workflow-engine",
    "dag",
    "sagas",
    "map-reduce",
    "durable"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "cron-parser": "^5.10.1",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/workflows"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
