{
  "name": "@cogitator-ai/worker",
  "version": "0.8.7",
  "description": "Distributed job queue for Cogitator agent execution",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "job-queue",
    "bullmq",
    "distributed",
    "workers"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "bullmq": "^6.3.11",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cogitator-ai/test-utils": "workspace:*",
    "ioredis": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/worker"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
