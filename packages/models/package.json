{
  "name": "@cogitator-ai/models",
  "version": "18.5.0",
  "description": "Dynamic model registry with pricing for Cogitator",
  "keywords": [
    "cogitator",
    "ai",
    "llm",
    "models",
    "model-registry",
    "pricing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "snapshot": "tsx scripts/update-litellm-snapshot.ts && tsx scripts/update-openrouter-snapshot.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/models"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
