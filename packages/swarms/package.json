{
  "name": "@cogitator-ai/swarms",
  "version": "0.10.5",
  "description": "Multi-agent swarm coordination for Cogitator",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "multi-agent",
    "swarms",
    "agent-orchestration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "@cogitator-ai/workflows": "workspace:*",
    "@types/node": "^22.20.4",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/swarms"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
