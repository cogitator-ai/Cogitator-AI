{
  "name": "@cogitator-ai/app-server",
  "version": "0.3.0",
  "description": "Typed JSON-RPC app-server for Cogitator: threads, turns and reviews over stdio, with a generated client",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "llm",
    "json-rpc",
    "app-server",
    "stdio",
    "ndjson",
    "acp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./client": {
      "types": "./dist/client/generated.d.ts",
      "import": "./dist/client/generated.js",
      "default": "./dist/client/generated.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "generate": "tsx src/codegen/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cogitator-ai/server-shared": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/test-utils": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@cogitator-ai/core": "workspace:>=0.77.0"
  },
  "peerDependenciesMeta": {
    "@cogitator-ai/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/app-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
