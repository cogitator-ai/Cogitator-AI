{
  "name": "@cogitator-ai/hono",
  "version": "0.6.9",
  "description": "Hono server adapter for Cogitator AI runtime — works on Node.js, Bun, Deno, Cloudflare Workers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cogitator-ai/core": "workspace:*",
    "@cogitator-ai/memory": "workspace:*",
    "@cogitator-ai/types": "workspace:*",
    "@cogitator-ai/server-shared": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "optionalDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*"
  },
  "devDependencies": {
    "@cogitator-ai/workflows": "workspace:*",
    "@cogitator-ai/swarms": "workspace:*",
    "@types/node": "^22.20.4",
    "hono": "^4.13.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/hono"
  },
  "license": "MIT",
  "keywords": [
    "cogitator",
    "ai",
    "agents",
    "hono",
    "server",
    "api",
    "streaming",
    "sse",
    "edge",
    "cloudflare-workers",
    "bun",
    "deno",
    "llm"
  ]
}
