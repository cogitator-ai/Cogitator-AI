{
  "name": "@cogitator-ai/server-shared",
  "version": "0.17.0",
  "description": "Shared streaming protocol and utilities for Cogitator server adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agui": {
      "types": "./dist/agui/index.d.ts",
      "import": "./dist/agui/index.js",
      "default": "./dist/agui/index.js"
    },
    "./json-patch": {
      "types": "./dist/json-patch.d.ts",
      "import": "./dist/json-patch.js",
      "default": "./dist/json-patch.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx ../../scripts/fix-esm-imports.ts .",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@cogitator-ai/types": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.3",
    "rxjs": "7.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitator-ai/Cogitator-AI.git",
    "directory": "packages/server-shared"
  },
  "license": "MIT",
  "keywords": [
    "cogitator",
    "ai",
    "streaming",
    "sse",
    "protocol",
    "ag-ui"
  ]
}
